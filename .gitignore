# Dependencies and build output
node_modules/
.next/
out/
build/
dist/
*.tsbuildinfo

# Secrets — never committed. See CLAUDE.md non-negotiables.
.env
.env.*
!.env.example
*.pem
*.key

# ---------------------------------------------------------------------------
# Client documents — deny by default, no exceptions.
#
# WHY there is no `!samples/` un-ignore rule: an exception directory is exactly
# where a real client statement eventually gets dropped "just to test something",
# and a real document in git history is a PDPA incident that deleting the file
# does not undo. Synthetic fixtures are GENERATED by a script at test time
# rather than committed as binaries, so this list needs no holes.
#
# If you ever need to commit a document, that is a decision to make deliberately
# with `git add -f` and a reviewer — not a default the tooling grants you.
# ---------------------------------------------------------------------------
*.pdf
*.PDF
*.csv
*.CSV
*.xls
*.xlsx
*.XLS
*.XLSX
*.jpg
*.jpeg
*.png
*.tif
*.tiff
*.heic
uploads/
documents/
client-data/

# Local tooling noise
.DS_Store
Thumbs.db
*.log
.vscode/
.idea/
coverage/

# Next.js generated, regenerated on every build
next-env.d.ts
