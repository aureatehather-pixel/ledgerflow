# Copy to .env.local and fill in. .env* is gitignored except this file.
# Never put real values here.

# Neon Postgres connection string.
# Record the ACTUAL provisioned region outside the repository; an intended region is not evidence.
DATABASE_URL=

# Better Auth signing secret. 32+ random bytes: openssl rand -base64 32
# `npm run check` passes with this empty (tests construct auth explicitly); the first
# `npm run dev` sign-in does not. See docs/SETUP.md §1.
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Cloudflare R2 (S3-compatible). Bucket must NOT have public access enabled.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Upload limits
MAX_UPLOAD_BYTES=15728640
