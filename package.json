{
  "name": "ledgerflow",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node --experimental-strip-types scripts/check-native-compiler.ts",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test",
    "demo": "vitest run test/demo.test.ts --reporter=verbose",
    "db:migrate": "node --experimental-strip-types scripts/migrate.ts",
    "storage:smoke": "vitest run --config vitest.smoke.config.ts"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.3",
    "@neondatabase/serverless": "^1.0.2",
    "@node-rs/argon2": "^2.0.2",
    "aws4fetch": "^1.0.20",
    "better-auth": "1.6.25",
    "drizzle-orm": "^0.45.2",
    "next": "^16.2.12",
    "pdfjs-dist": "^6.2.108",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.11",
    "@eslint/js": "9.37.0",
    "@types/node": "24.7.0",
    "@types/react": "19.1.11",
    "@types/react-dom": "19.1.7",
    "eslint": "9.37.0",
    "eslint-config-next": "^16.2.12",
    "typescript": "5.9.2",
    "typescript-eslint": "8.45.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "brace-expansion": "^5.0.8",
    "postcss": "^8.5.18",
    "sharp": "^0.35.3"
  }
}
